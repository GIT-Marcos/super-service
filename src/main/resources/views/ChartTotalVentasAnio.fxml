<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>


<BorderPane minHeight="560.0" minWidth="900.0" prefHeight="560.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SPRService.SPRService.controllers.ChartTotalVentasAnioController">
   <center>
      <AreaChart fx:id="chart" animated="false" BorderPane.alignment="CENTER">
        <xAxis>
          <CategoryAxis side="BOTTOM" />
        </xAxis>
        <yAxis>
          <NumberAxis side="LEFT" />
        </yAxis>
      </AreaChart>
   </center>
   <top>
      <AnchorPane maxHeight="130.0" minHeight="90.0" prefHeight="130.0" BorderPane.alignment="CENTER">
         <children>
            <Spinner fx:id="spinnerAnio" layoutX="14.0" layoutY="27.0" />
            <Label layoutX="14.0" layoutY="4.0" text="Seleccione el año sobre el que quiere generar el reporte">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Button layoutX="759.0" layoutY="91.0" mnemonicParsing="false" onAction="#exportarJPG" text="Exportar como JPG" AnchorPane.rightAnchor="14.014903367031025" />
            <Button layoutX="14.0" layoutY="63.0" minWidth="300.0" mnemonicParsing="false" onAction="#generarReporteIngresos" prefWidth="300.0" text="Generar reporte de INGRESOS de ventas por mes" />
            <Button layoutX="14.0" layoutY="91.0" minWidth="300.0" mnemonicParsing="false" onAction="#generarReporteCantidad" prefWidth="300.0" text="Generar reporte de CANTIDAD de ventas por mes" />
         </children>
      </AnchorPane>
   </top>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</BorderPane>
