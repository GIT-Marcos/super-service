<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" maxHeight="600.0" maxWidth="1000.0" minHeight="600.0" minWidth="1000.0" prefHeight="600.0" prefWidth="1000.0" styleClass="root" stylesheets="@../styles/vehiculos.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SPRService.SPRService.controllers.VehiculosController">

    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-panel">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="5.0" top="15.0" />
                    </padding>
                    <children>

                        <Label styleClass="section-label" text="Filtros de Búsqueda:">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <VBox prefHeight="52.0" prefWidth="150.0" spacing="2.0">
                            <children>
                                <Label text="Patente" />
                                <TextField fx:id="tfPatente" maxWidth="1.7976931348623157E308" minWidth="140.0" prefWidth="140.0" promptText="Patente..." styleClass="text-field" />
                            </children>
                        </VBox>

                        <VBox prefHeight="52.0" prefWidth="220.0" spacing="2.0">
                            <children>
                                <Label text="Modelo" />
                                <TextField fx:id="tfModelo" maxWidth="1.7976931348623157E308" minWidth="140.0" prefWidth="140.0" promptText="Modelo..." styleClass="text-field" />
                            </children>
                        </VBox>

                        <VBox prefHeight="52.0" prefWidth="180.0" spacing="2.0">
                            <children>
                                <Label text="Marca" />
                                <TextField fx:id="tfMarca" maxWidth="1.7976931348623157E308" minWidth="140.0" prefWidth="140.0" promptText="Marca..." styleClass="text-field" />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <VBox alignment="BOTTOM_LEFT" spacing="5.0">
                            <children>
                                <Button maxWidth="150.0" mnemonicParsing="false" onAction="#buscarConFiltros" prefWidth="150.0" styleClass="btn-primary" text="🔍 Buscar con filtros" />
                                <Button maxWidth="150.0" mnemonicParsing="false" onAction="#todosLosVehiculos" prefWidth="150.0" styleClass="btn-primary" text="Mostrar Todos" />
                            </children>
                        </VBox>

                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tablaVehiculos" styleClass="table-view" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colPatente" prefWidth="100.0" text="Patente" />
                <TableColumn fx:id="colMarca" prefWidth="150.0" text="Marca" />
                <TableColumn fx:id="colModelo" prefWidth="200.0" text="Modelo" />
                <TableColumn fx:id="colCil" prefWidth="80.0" text="Cil. cc." />
                <TableColumn fx:id="colAnio" prefWidth="70.0" text="Año" />
                <TableColumn fx:id="colColor" prefWidth="100.0" text="Color" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </BorderPane.margin>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>

    <right>
        <VBox maxWidth="160.0" minWidth="160.0" prefWidth="160.0" spacing="8.0" styleClass="sidebar">
            <children>
                <Label styleClass="section-label" text="ACCIONES PRINCIPALES">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cargarVehiculo" styleClass="btn-success" text="➕ Cargar vehículo" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#modificarVehiculo" text="✏ Modificar vehículo" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#verDetalles" styleClass="button" text="👁 Ver detalles" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eliminarVehiculo" styleClass="btn-danger" text="🗑 Eliminar vehículo" />

                <Separator prefWidth="200.0" />

                <Label styleClass="section-label" text="GENERACIÓN DE REPORTES">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#generarReporteMasRegistrados" styleClass="btn-report" text="🏆 Modelos más registrados" wrapText="true">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Button>

                <Separator prefWidth="200.0" />

                <Label styleClass="section-label" text="EXPORTAR">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="comboFormato" maxWidth="1.7976931348623157E308" promptText="Formato..." styleClass="combo-compact" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#exportarTabla" text="⬇Descargar" />

            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </right>
</BorderPane>
