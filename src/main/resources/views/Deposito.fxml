<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.controlsfx.control.CheckComboBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" stylesheets="@../styles/deposito.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SPRService.SPRService.controllers.DepositoController">

    <!-- PARTE SUPERIOR -->
    <top>
        <VBox spacing="8.0" styleClass="top-panel" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
            </padding>
            <children>
                <!-- FILA 1: Búsqueda Principal -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label styleClass="header-icon" text="🔍" textFill="WHITE">
                            <font><Font size="18.0" /></font>
                        </Label>

                        <TextField fx:id="tfCodigo" prefWidth="130.0" promptText="Cód. Barras" />
                        <TextField fx:id="tfNombre" promptText="Nombre del repuesto" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="tfMarca" prefWidth="130.0" promptText="Marca" />

                        <Button fx:id="butBuscar" defaultButton="true" mnemonicParsing="false" onAction="#buscarConFiltros" prefWidth="100.0" styleClass="btn-primary" text="🔍 Buscar" />
                        <Button fx:id="btnTodosRepuestos" mnemonicParsing="false" onAction="#todosRepuestos" prefWidth="100.0" styleClass="btn-primary" text="📋 Ver Todos" />
                    </children>
                </HBox>

                <!-- FILA 2: Filtros y Ordenamiento -->
                <HBox alignment="CENTER_LEFT" spacing="5.0">
                    <children>
                        <Label text="Filtros:" textFill="#b2bec3" />
                        <CheckBox fx:id="checkMostrarNormal" selected="true" text="Ver stock normal" />
                        <CheckBox fx:id="checkMostrarBajo" selected="true" text="Ver stock bajo" />

                        <Separator orientation="VERTICAL" />

                        <CheckBox fx:id="chActivos" selected="true" text="Activos" />
                        <CheckBox fx:id="chInactivos" text="Inactivos" />

                        <Separator orientation="VERTICAL" />

                        <Label text="📍" textFill="#b2bec3">
                            <font><Font size="14.0" /></font>
                        </Label>
                        <CheckComboBox fx:id="checkComboUbicaciones" prefWidth="180.0" title="Ubicaciones">
                            <tooltip><Tooltip text="Filtrar por ubicación" /></tooltip>
                        </CheckComboBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="Ordenar:" textFill="#b2bec3" />
                        <ComboBox fx:id="comboOrdenarPor" prefWidth="140.0" promptText="Campo" />
                        <ComboBox fx:id="comboTipoOrden" prefWidth="140.0" promptText="Orden" />
                    </children>
                </HBox>

                <!-- FILA 3: Aviso de Stock Crítico (solo visible cuando hay alertas) -->
                <HBox fx:id="hboxAvisoStock" alignment="CENTER_LEFT" managed="false" spacing="5.0" styleClass="alert-bar" visible="false">
                    <children>
                        <Label fx:id="labelAvisoStock" styleClass="alert-label-compact" text="⚠ Repuestos activos con Stock Crítico" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <!-- CENTRO: TABLA Y PAGINACIÓN -->
    <center>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <children>
                <TableView fx:id="tablaRepuestos" fixedCellSize="0.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodBarra" prefWidth="100.0" text="Cód. Barras" />
                        <TableColumn fx:id="colDetalle" prefWidth="210.0" text="Nombre / Descripción" />
                        <TableColumn fx:id="colMarca" text="Marca" />
                        <TableColumn fx:id="colPrecio" style="-fx-alignment: CENTER-RIGHT;" text="Precio $" />
                        <TableColumn fx:id="colCantidad" prefWidth="60.0" style="-fx-alignment: CENTER;" text="Stock" />
                        <TableColumn fx:id="colCantidadMinima" prefWidth="60.0" style="-fx-alignment: CENTER;" text="Mín." />
                        <TableColumn fx:id="colUniMedida" prefWidth="60.0" text="Unidad" />
                        <TableColumn fx:id="colEstado" prefWidth="70.0" text="Estado" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <Pagination fx:id="paginacion" maxPageIndicatorCount="5" pageCount="1" />
            </children>
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </padding>
        </VBox>
    </center>

    <!-- DERECHA: MENÚ LATERAL -->
    <right>
        <VBox prefWidth="160.0" spacing="8.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label styleClass="section-label" text="ACCIONES" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#nuevoRepuesto" styleClass="btn-success" text="➕ Nuevo">
                    <tooltip><Tooltip text="Agregar nuevo repuesto" /></tooltip>
                </Button>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#modRepuesto" text="📝 Detalles/Modificar" />
                <Button fx:id="btnBaja" maxWidth="Infinity" mnemonicParsing="false" onAction="#borrarRepuesto" styleClass="btn-danger" text="🗑 Dar de baja" />

                <Separator />

                <Label styleClass="section-label" text="STOCK" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#ingresarStock" styleClass="btn-action" text="📦 Ingresar" />

                <Separator />

                <Label styleClass="section-label" text="REPORTES" />
                <Button fx:id="btnRepMasRetirados" maxWidth="Infinity" mnemonicParsing="false" onAction="#masRetiradosParaVenta" styleClass="btn-report" text="📊 Más Retirados" />
                <Button fx:id="btnRepUsos" maxWidth="Infinity" mnemonicParsing="false" onAction="#usoDeRepuestos" styleClass="btn-report" text="📉 Uso Repuestos" />

                <Separator />
                <Label styleClass="section-label" text="EXPORTAR" />
                <ComboBox fx:id="comboFormatos" maxWidth="Infinity" styleClass="combo-compact" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#generar" text="⬇ Descargar" />
            </children>
            <BorderPane.margin>
                <Insets bottom="5.0" right="5.0" top="5.0" />
            </BorderPane.margin>
        </VBox>
    </right>
</BorderPane>
