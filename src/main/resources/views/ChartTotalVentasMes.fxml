<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="500.0" minWidth="900.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SPRService.SPRService.controllers.ChartTotalVentasMesController">
   <top>
      <AnchorPane maxHeight="90.0" minHeight="80.0" prefHeight="90.0" BorderPane.alignment="CENTER">
         <children>
            <Label layoutX="14.0" layoutY="5.0" text="Seleccione el mes y el año sobre el que quiere generar el reporte">
               <font>
                  <Font size="14.0" />
               </font></Label>
            <Button layoutX="759.0" layoutY="63.0" mnemonicParsing="false" onAction="#exportarJPG" text="Exportar como JPG" AnchorPane.rightAnchor="14.014903367031067" />
            <Button layoutX="14.0" layoutY="63.0" mnemonicParsing="false" onAction="#generar" text="Generar" />
            <ComboBox fx:id="comboMeses" layoutX="14.0" layoutY="28.0" prefWidth="150.0" />
            <Spinner fx:id="spinnerAnio" layoutX="165.0" layoutY="28.0" />
         </children>
      </AnchorPane>
   </top>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
   <center>
      <BarChart fx:id="chart" BorderPane.alignment="CENTER">
        <xAxis>
          <CategoryAxis />
        </xAxis>
        <yAxis>
          <NumberAxis side="LEFT" />
        </yAxis>
      </BarChart>
   </center>
</BorderPane>
