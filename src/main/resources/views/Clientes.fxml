<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="root" stylesheets="@../styles/clientes.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SPRService.SPRService.controllers.ClienteController">

    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-panel">
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="10.0" top="15.0" />
                    </padding>
                    <children>

                        <Label styleClass="section-label" text="Filtros de Búsqueda:">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <VBox spacing="2.0">
                            <children>
                                <Label text="DNI" />
                                <TextField fx:id="tfDNI" maxWidth="160.0" minWidth="160.0" prefWidth="160.0" promptText="DNI..." styleClass="text-field" />
                            </children>
                        </VBox>

                        <VBox spacing="2.0">
                            <children>
                                <Label text="Apellido" />
                                <TextField fx:id="tfApellido" maxWidth="160.0" minWidth="160.0" prefWidth="160.0" promptText="Apellido..." styleClass="text-field" />
                            </children>
                        </VBox>

                        <VBox spacing="2.0">
                            <children>
                                <Label text="Nombre" />
                                <TextField fx:id="tfNombre" maxWidth="160.0" minWidth="160.0" prefWidth="160.0" promptText="Nombre..." styleClass="text-field" />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <VBox alignment="BOTTOM_LEFT" spacing="5.0">
                            <children>
                                <Button maxWidth="150.0" mnemonicParsing="false" onAction="#buscarConFiltros" prefWidth="150.0" styleClass="btn-primary" text="🔍 Buscar con filtros" />
                                <Button maxWidth="150.0" mnemonicParsing="false" onAction="#todosLosClientes" prefWidth="150.0" styleClass="btn-primary" text="📋 Ver Todos" />
                            </children>
                        </VBox>

                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tablaClientes" styleClass="table-view" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colDNI" prefWidth="200.0" text="DNI" />
                <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre" />
                <TableColumn fx:id="colApellido" prefWidth="250.0" text="Apellido" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </BorderPane.margin>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>

    <right>
        <VBox maxWidth="160.0" minWidth="160.0" prefWidth="160.0" spacing="8.0" styleClass="sidebar" BorderPane.alignment="TOP_CENTER">
            <children>
                <Label styleClass="section-label" text="ACCIONES PRINCIPALES">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#nuevoCliente" styleClass="btn-success" text="➕ Nuevo cliente" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#modificar" text="✏ Detalles/Modificar" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#darDeBaja" styleClass="btn-danger" text="🗑 Dar de baja" />

                <Separator prefWidth="200.0" />

                <Label styleClass="section-label" text="GENERACIÓN DE EPORTES">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Button disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-report" text="🏆 Clientes más frecuentes" wrapText="true">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Button>

            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </right>
</BorderPane>
