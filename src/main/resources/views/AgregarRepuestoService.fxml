<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.controlsfx.control.textfield.CustomTextField?>

<BorderPane maxHeight="400.0" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SPRService.SPRService.controllers.AgregarRepuestoServiceController">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <Label text="Busca el repuesto por código de barras, nombre o marca:">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <CustomTextField fx:id="ctfBuscar" promptText="Buscar...">
               <font>
                  <Font size="13.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </CustomTextField>
            <Label text="Indique la cantidad que se va utilizar de repuesto:">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <CustomTextField fx:id="ctfCantidad" promptText="Cantidad..." />
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
   <center>
      <ListView fx:id="lvRepuestos" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
      </ListView>
   </center>
   <bottom>
      <Button mnemonicParsing="false" onAction="#agregarRepuesto" text="Agregar repuesto seleccionado" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
