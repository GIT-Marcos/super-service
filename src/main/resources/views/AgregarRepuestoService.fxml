<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.controlsfx.control.textfield.CustomTextField?>

<BorderPane maxHeight="490.0" maxWidth="-Infinity" minHeight="490.0" minWidth="600.0" prefHeight="490.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SPRService.SPRService.controllers.AgregarRepuestoServiceController">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <Label text="Buscar el repuesto por código de barras, nombre o marca:">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <HBox maxHeight="30.0" minHeight="30.0" prefHeight="30.0" prefWidth="590.0" spacing="15.0">
               <children>
                  <TextField fx:id="tfCodBarras" promptText="Código de barras..." />
                  <TextField fx:id="tfNombre" promptText="Nombre producto..." />
                  <TextField fx:id="tfMarca" promptText="Marca producto..." />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#buscar" text="Buscar" />
                  <CheckBox fx:id="cbStockBajo" mnemonicParsing="false" selected="true" text="Ver stock bajo" />
                  <CheckBox fx:id="cbStockNormal" mnemonicParsing="false" selected="true" text="Ver stock normal" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
   <center>
      <VBox BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="10.0" />
         </BorderPane.margin>
         <children>
            <ListView fx:id="lvRepuestos" prefHeight="290.0" prefWidth="590.0">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </ListView>
            <Label text="Indique la cantidad que se va utilizar de repuesto:">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <CustomTextField fx:id="ctfCantidad" promptText="Cantidad..." />
         </children>
      </VBox>
   </center>
   <bottom>
      <Button mnemonicParsing="false" onAction="#agregarRepuesto" text="Agregar repuesto seleccionado" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
