<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="600.0" styleClass="root" stylesheets="@../styles/vehiculos.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SPRService.SPRService.controllers.WizardCargarVehiculoController">

    <!-- 1. HEADER (Estilo top-panel Naranja) -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="top-panel" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <children>
                <VBox>
                    <children>
                        <Label text="VEHÍCULO" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label text="Asistente de carga" textFill="WHITE">
                            <font>
                                <Font size="11.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </top>

    <!-- 2. CENTRO (Contenido dinámico) -->
    <center>
        <StackPane fx:id="stackPane" style="-fx-background-color: #f0f2f5;" BorderPane.alignment="CENTER" />
    </center>

    <!-- 3. FOOTER (Navegación) -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #ffffff; -fx-border-color: #dcdcdc; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <!-- Botón Volver -->
                <Button fx:id="btnVolver" cancelButton="true" mnemonicParsing="false" onAction="#volver" prefWidth="90.0" text="Anterior" />

                <!-- Texto Informativo -->
                <Label text="(*) Campos obligatorios" textFill="#7f8c8d">
                    <font>
                        <Font size="11.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Label>

                <!-- Espaciador para empujar botones a la derecha -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Botón Siguiente -->
                <Button fx:id="btnSiguiente" defaultButton="true" mnemonicParsing="false" onAction="#siguiente" prefWidth="100.0" styleClass="btn-primary" text="Siguiente" />

                <!-- Botón Finalizar (inicialmente oculto o visible según lógica del controlador) -->
                <Button fx:id="btnFinalizar" mnemonicParsing="false" onAction="#finalizar" prefWidth="100.0" styleClass="btn-success" text="Finalizar" />
            </children>
        </HBox>
    </bottom>

</BorderPane>
