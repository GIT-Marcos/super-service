<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="950.0" styleClass="root" stylesheets="@../styles/ventas.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SPRService.SPRService.controllers.CargarVentaController">

    <!-- 1. HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="top-panel" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Label text="PUNTO DE VENTA" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Nueva Operación" textFill="#bdc3c7">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <!-- 2. BARRA LATERAL (DERECHA) - MODIFICADA -->
    <right>
        <VBox prefWidth="230.0" spacing="10.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>

                <!-- NUEVA SECCIÓN: GESTIÓN DE CLIENTE -->
                <Label styleClass="section-label" text="DATOS DEL CLIENTE" />
                <Separator />

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#seleccionarCliente" prefHeight="35.0" styleClass="btn-primary" text="👤 Seleccionar Cliente" />

                <!-- Tarjeta de Información del Cliente -->
                <VBox spacing="5.0" style="-fx-background-color: #f1f2f6; -fx-border-color: #dcdcdc; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;">
                    <children>
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #7f8fa6;" text="Nombre y Apellido:" />
                          <Label fx:id="lblNombreCliente" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="---" wrapText="true" />

                        <Separator style="-fx-opacity: 0.5;" />

                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                            <children>
                                <Label style="-fx-font-size: 10px; -fx-text-fill: #7f8fa6;" text="DNI/CUIT:" />
                                <Label fx:id="lblDniCliente" style="-fx-font-size: 11px; -fx-font-weight: bold;" text="---" />
                            </children>
                        </HBox>
                  <CheckBox fx:id="chConsumidorFinal" mnemonicParsing="false" onAction="#checkConsumidorFinal" selected="true" text="Es consumidor final" underline="true" />
                    </children>
                </VBox>

                <Region prefHeight="10.0" />

                <!-- SECCIÓN EXISTENTE: ACCIONES -->
                <Label styleClass="section-label" text="ACCIONES DE PRODUCTO" />
                <Separator />

                <Button fx:id="btnAgregarProducto" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirModalAgregarProducto" prefHeight="40.0" styleClass="btn-action" text="➕ Agregar Producto" />

                <Region VBox.vgrow="ALWAYS" />

                <!-- SECCIÓN EXISTENTE: GESTIÓN DE LISTA -->
                <Label styleClass="section-label" text="GESTIÓN DE LISTA" />
                <Separator />
                <Button fx:id="btnLimpiarLista" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpiarLista" styleClass="btn-danger" text="🗑 Limpiar Todo" />
            </children>
        </VBox>
    </right>

    <!-- 3. CONTENIDO CENTRAL (LISTA) -->
    <center>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="15.0" right="5.0" top="15.0" />
            </padding>
            <children>
                <Label styleClass="section-label" text="DETALLE DE ITEMS A FACTURAR" />
                <ListView fx:id="lista" style="-fx-background-radius: 3; -fx-border-color: #dcdcdc; -fx-border-radius: 3;" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </center>

    <!-- 4. FOOTER (TOTALES Y PAGO) -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #ffffff; -fx-border-color: #dcdcdc; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <children>
                <!-- Opciones -->
                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="section-label" text="OPCIONES DE SALIDA" />
                        <CheckBox fx:id="chkGuardarRuta" mnemonicParsing="false" selected="true" text="Guardar en ruta por defecto">
                            <font>
                                <Font size="11.0" />
                            </font></CheckBox>
                        <CheckBox fx:id="chkImprimir" mnemonicParsing="false" text="Imprimir Nota de Retiro">
                            <font>
                                <Font size="11.0" />
                            </font></CheckBox>
                    </children>
                </VBox>

                <!-- Espaciador -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Total -->
                <VBox alignment="CENTER_RIGHT">
                    <children>
                        <Label styleClass="section-label" text="TOTAL A PAGAR" />
                        <Label fx:id="lblTotal" text="\$ 0.00" textFill="#27ae60">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Botón Pagar -->
                <Button fx:id="btnPagar" mnemonicParsing="false" onAction="#abrirModalPago" prefHeight="50.0" prefWidth="140.0" styleClass="btn-success" text="💰 COBRAR">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Button>
            </children>
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
        </HBox>
    </bottom>

</BorderPane>
