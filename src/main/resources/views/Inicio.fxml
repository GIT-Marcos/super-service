<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<VBox styleClass="main-bg" stylesheets="@../styles/inicio.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SPRService.SPRService.controllers.InicioController">
   <children>
      <StackPane fx:id="pane" minHeight="450.0" prefHeight="450.0" />
      <Separator prefWidth="200.0">
         <VBox.margin>
            <Insets left="5.0" right="5.0" />
         </VBox.margin>
      </Separator>
      <HBox maxWidth="1.7976931348623157E308" minHeight="50.0" spacing="5.0">
         <children>
            <Button mnemonicParsing="false" onAction="#salir" styleClass="btn-exit" text="Salir" />
            <Region maxWidth="1.7976931348623157E308" prefHeight="40.0" prefWidth="176.0" />
            <Button mnemonicParsing="false" onAction="#iniciarSesion" styleClass="btn-outline" text="Sesión" />
            <Button mnemonicParsing="false" onAction="#nuevoUsuario" styleClass="btn-outline" text="Usuario" />
         </children>
         <padding>
            <Insets left="5.0" right="5.0" top="10.0" />
         </padding>
      </HBox>
   </children>
</VBox>
